#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"  // Deutsches Layout, Datei liegt in config/

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Hold = Umlaut, Tap = Buchstabe. Nutzung: &umlaut DE_A_UMLAUT DE_A
        umlaut: umlaut_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "UMLAUT_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <210>;
            bindings = <&kp>, <&kp>;
        };

        // Tap = Backspace, Hold = Delete. Nutzung: &bs_del DELETE BACKSPACE
        bs_del: backspace_delete {
            compatible = "zmk,behavior-hold-tap";
            label = "BACKSPACE_DELETE";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <210>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Tap-Dance: 1x tippen = Super (LGUI), 2x tippen = Strg + Super (LCTRL + LGUI)
        td_super: tap_dance_super {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_SUPER";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&kp LC(LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        keypad {
            display-name = "Kp";
            bindings = <
&none      &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6                                                                                           &kp F7         &kp F8      &kp F9                    &kp F10                   &kp F11             &kp F12            &none
&none      &kp DE_Q    &kp DE_W    &kp DE_E    &kp DE_R    &kp DE_T    &none                                                                                            &none          &kp DE_Z    &umlaut DE_U_UMLAUT DE_U  &kp DE_I                  &umlaut DE_O_UMLAUT DE_O  &kp DE_SHARP_S  &none
&kp TAB    &umlaut DE_A_UMLAUT DE_A  &kp DE_S  &kp DE_D  &kp DE_F  &kp DE_G  &none    &kp PAGE_DOWN  &kp PAGE_UP                  &tog 2     &kp ESCAPE  &none          &kp DE_H       &kp DE_J    &kp DE_K                  &kp DE_L                  &kp DE_P            &none
&kp LSHFT  &kp DE_Y    &kp DE_X    &kp DE_C    &kp DE_V    &kp DE_B                                &kp LEFT_CONTROL  &td_super                                                &kp DE_N       &kp DE_M    &kp DE_COMMA              &kp DE_PERIOD             &kp DE_MINUS        &kp RSHFT
&none      &none       &none       &none       &none                                   &kp SPACE   &to 1          &kp LEFT_ALT                   &to 3      &kp ENTER   &bs_del DELETE BACKSPACE   &kp LEFT       &kp UP_ARROW  &kp DOWN                &kp RIGHT                 &none
            >;
        };

        NumbersAndMath {
            display-name = "Symbols";
            bindings = <
&none   &none            &none            &none              &none            &none              &none                                                &none   &none            &none            &none                 &none            &none   &none
&trans  &trans           &kp DE_EURO      &kp DE_DQT         &kp DE_EXCL      &kp DE_DQT         &none                                                &none   &kp DE_SINGLE_QUOTE  &kp DE_AMPERSAND  &kp DE_SECTION   &trans           &trans  &trans
&trans  &kp N0           &kp N1           &kp N2             &kp N3           &kp N4             &kp N5           &trans  &trans      &trans  &trans  &none   &kp N6           &kp N7           &kp N8                &kp N9           &trans  &trans
&trans  &kp DE_A_UMLAUT  &kp DE_O_UMLAUT  &kp DE_EQUAL        &kp DE_MINUS     &kp DE_PLUS                                 &trans      &trans                  &kp DE_ASTERISK  &kp DE_SLASH     &kp DE_BACKSLASH      &trans           &trans  &trans
&trans  &trans           &trans           &trans             &trans                              &trans           &to 0   &trans      &trans  &trans  &trans                   &trans           &trans                &trans           &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &none  &none          &none  &none           &none                 &none                                             &trans           &none                  &none            &none       &none  &none        &none
&none           &none  &none          &none  &kp DE_LBRC     &kp DE_LBKT           &bootloader                                       &bootloader      &kp DE_RBKT            &kp DE_RBRC      &none       &none  &none        &none
&studio_unlock  &none  &kp DE_DOLLAR  &none  &none           &kp DE_LPAR           &none        &none  &none      &tog 2  &none       &none            &kp DE_RPAR            &mmv MOVE_UP     &none       &none  &kp DE_PIPE  &none
&none           &none  &none          &none  &none           &kp DE_LT                                 &none      &none                               &kp DE_GT              &none            &none       &none  &none        &none
&none           &none  &none          &none  &none                                 &none        &none  &none      &none  &bl BL_TOG  &rgb_ug RGB_TOG                         &bl BL_INC       &bl BL_DEC  &none  &none        &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
