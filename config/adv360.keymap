#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Tap-Dance: 1x tippen = Super (LGUI), 2x tippen = Strg + Super (LCTRL + LGUI)

        td_super: tap_dance_super {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_SUPER";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&kp LC(LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        keypad {
            display-name = "Kp";
            bindings = <
&none      &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                                                                 &kp F7         &kp F8  &kp F9    &kp F10       &kp F11   &kp F12    &none
&none      &kp Q   &kp W   &kp E   &kp R   &kp T   &none                                                                  &none          &kp Z   &kp U     &kp I         &kp O     &kp S      &none
&kp TAB    &kp A   &kp S   &kp D   &kp F   &kp G   &none      &kp PAGE_DOWN  &kp PAGE_UP           &tog 2     &kp ESCAPE  &none          &kp H   &kp J     &kp K         &kp L     &kp P      &none
&kp LSHFT  &kp Y   &kp X   &kp C   &kp V   &kp B                             &kp LEFT_CONTROL      &td_super                             &kp N   &kp M     &kp COMMA     &kp DOT   &kt MINUS  &kp RSHFT
&none      &none   &none   &none   &none           &kp SPACE  &to 1          &kp LEFT_ALT          &to 3      &kp ENTER   &kp BACKSPACE          &kp LEFT  &kp UP_ARROW  &kp DOWN  &kp RIGHT  &none
            >;
        };

        NumbersAndMath {
            display-name = "Fn";
            bindings = <
&none   &none            &none            &none            &none            &none            &none                                                &none   &none            &none            &none            &none            &none   &none
&trans  &trans           &kp E            &trans           &kp EXCLAMATION  &kp PERCENT      &none                                                &none   &kp AMPERSAND    &kp QUESTION     &trans           &trans           &trans  &trans
&trans  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &trans  &trans      &trans  &trans  &none   &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans  &trans
&trans  &trans           &trans           &kp EQUAL        &kp PLUS         &kp MINUS                                 &trans      &trans                  &kp ASTERISK     &kp SLASH        &kp BSLH         &trans           &trans  &trans
&trans  &trans           &trans           &trans           &trans                            &trans           &trans  &trans      &trans  &trans  &trans                   &trans           &trans           &trans           &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &none  &none       &none  &none              &none                 &none                                             &trans           &none                  &none       &none       &none  &none     &none
&none           &none  &none       &none  &kp DOUBLE_QUOTES  &kp LBRC              &bootloader                                       &bootloader      &kp RIGHT_BRACE        &kp SQT     &none       &none  &none     &none
&studio_unlock  &none  &kp DOLLAR  &none  &none              &kp LEFT_PARENTHESIS  &none        &none  &none      &none  &none       &none            &kp RIGHT_PARENTHESIS  &none       &none       &none  &kp PIPE  &none
&none           &none  &none       &none  &none              &kp LESS_THAN                             &none      &none                               &kp GT                 &none       &none       &none  &none     &none
&none           &none  &none       &none  &none                                    &none        &none  &none      &none  &bl BL_TOG  &rgb_ug RGB_TOG                         &bl BL_INC  &bl BL_DEC  &none  &none     &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
