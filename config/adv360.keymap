#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Tap-Dance: 1x tippen = Super (LGUI), 2x tippen = Strg + Super (LCTRL + LGUI)

        td_super: tap_dance_super {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_SUPER";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LGUI>, <&kp LC(LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&none      &kp F1     &kp F2    &kp F3    &kp F4     &kp F5  &kp F6                                                   &kp F7     &kp F8  &kp F9  &kp F10    &kp F11   &kp F12   &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &td_super                        &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &to 2      &kp END       &kp PG_DN  &kp ENTER  &kp ENTER          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&none      &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                                                                 &kp F7         &kp F8  &kp F9    &kp F10       &kp F11   &kp F12    &none
&none      &kp Q   &kp W   &kp E   &kp R   &kp T   &none                                                                  &none          &kp Z   &kp U     &kp I         &kp O     &kp S      &none
&kp TAB    &kp A   &kp S   &kp D   &kp F   &kp G   &none      &kp PAGE_DOWN  &kp PAGE_UP           &tog 3     &kp ESCAPE  &none          &kp H   &kp J     &kp K         &kp L     &kp P      &none
&kp LSHFT  &kp Y   &kp X   &kp C   &kp V   &kp B                             &kp LEFT_CONTROL      &td_super                             &kp N   &kp M     &kp COMMA     &kp DOT   &kt MINUS  &kp RSHFT
&none      &none   &none   &none   &none           &kp SPACE  &to 2          &kp LEFT_ALT          &to 4      &kp ENTER   &kp BACKSPACE          &kp LEFT  &kp UP_ARROW  &kp DOWN  &kp RIGHT  &none
            >;
        };

        NumbersAndMath {
            display-name = "Fn";
            bindings = <
&none   &none            &none            &none            &none            &none            &none                                                &none   &none            &none            &none            &none            &none   &none
&trans  &trans           &kp E            &trans           &kp EQUAL        &kp PERCENT      &none                                                &none   &kp AMPERSAND    &trans           &trans           &trans           &trans  &trans
&trans  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &trans  &trans      &trans  &trans  &none   &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans  &trans
&trans  &trans           &trans           &trans           &kp PLUS         &kp MINUS                                 &trans      &trans                  &kp ASTERISK     &kp SLASH        &kp BSLH         &trans           &trans  &trans
&trans  &trans           &trans           &trans           &trans                            &trans           &trans  &trans      &trans  &trans  &trans                   &trans           &trans           &trans           &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4          &none                                                  &trans           &none                  &none       &none       &none  &none     &none
&none           &none         &none         &none         &none         &kp LBRC              &bootloader                                            &bootloader      &kp RIGHT_BRACE        &none       &none       &none  &none     &none
&studio_unlock  &none         &kp DOLLAR    &none         &none         &kp LEFT_PARENTHESIS  &none        &none  &none      &bt BT_CLR  &none       &none            &kp RIGHT_PARENTHESIS  &none       &none       &none  &kp PIPE  &none
&none           &none         &none         &none         &none         &kp LESS_THAN                             &none      &none                                    &kp LS(GREATER_THAN)   &none       &none       &none  &none     &none
&none           &none         &none         &none         &none                               &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                         &bl BL_INC  &bl BL_DEC  &none  &none     &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
